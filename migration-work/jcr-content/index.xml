  <jcr:content cq:template="/libs/core/franklin/templates/page" sling:resourceType="core/franklin/components/page/v1/page" jcr:primaryType="cq:PageContent" jcr:title="Wireless Broadband for First Responders and Public Safety | FirstNet" jcr:description="The FirstNet mission is to deploy, operate, maintain and improve the first high-speed, nationwide wireless broadband network for first responders, public safety and emergency response teams.​" modelFields="[jcr:title,jcr:description,keywords]">
