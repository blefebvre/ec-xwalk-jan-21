        <title_1 sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="Trends made for your lifestyle" titleType="h2"/>
        <block sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" filter="cards-icon-features" name="Cards Icon Features">
          <item_0 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" image="" text="&lt;p&gt;Fresh drops for every mood—tennis whites, beach brights, party fits. Your next look starts here.&lt;/p&gt;"></item_0>
          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" image="" text="&lt;p&gt;Game on! Sporty vibes meet street style. Sneakers, sets, and all the cool you need.&lt;/p&gt;"></item_1>
          <item_2 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" image="" text="&lt;p&gt;Chill never looked this good. Easy layers, bold extras—fun, effortless, always you.&lt;/p&gt;"></item_2>
          <item_3 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" image="" text="&lt;p&gt;Ready to shine? Statement looks and playful details for nights you’ll never forget.&lt;/p&gt;"></item_3>
          <item_4 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" image="" text="&lt;p&gt;Remix your style. Layer, clash, repeat—make every outfit your own.&lt;/p&gt;"></item_4>
          <item_5 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" image="" text="&lt;p&gt;Hot new labels. Discover the brands everyone’s buzzing about—before they go big.&lt;/p&gt;"></item_5>
          <item_6 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" image="" text="&lt;p&gt;Real people, real style. See how trendsetters own the scene, one outfit at a time.&lt;/p&gt;"></item_6>
          <item_7 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" image="" text="&lt;p&gt;Season’s essentials. Stay ahead with our top picks—what’s trending right now.&lt;/p&gt;"></item_7>
