          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Accordion Faq Item" model="accordion-faq-item" summary="What’s hot for beach days?" text="&lt;p&gt;Go bright, breezy, and bold. Sporty suits, bucket hats, and oversized sunnies bring the fun.&lt;/p&gt;" modelFields="[summary,text]"></item_1>
          <item_2 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Accordion Faq Item" model="accordion-faq-item" summary="Mixing sporty with casual—can I?" text="&lt;p&gt;Totally! Try a tennis skirt with a graphic tee or toss a hoodie over swimwear for instant cool.&lt;/p&gt;" modelFields="[summary,text]"></item_2>
          <item_3 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Accordion Faq Item" model="accordion-faq-item" summary="How do basics get a glow-up?" text="&lt;p&gt;Layer textures, add color pops, or stack on chunky jewelry. Even a cap can flip your vibe.&lt;/p&gt;" modelFields="[summary,text]"></item_3>
