          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" image="https://cdn.prod.website-files.com/685659f2651d1abee4832887/68565a6c90d15f06db8c3063_05222b1a-c1f8-4466-a89e-8372f97aecc0.avif" text="&lt;p&gt;&lt;strong&gt;Sunny&lt;/strong&gt; · 4 min read&lt;/p&gt;&lt;p&gt;&lt;h3&gt;Wave-ready, wow-worthy&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;Taylor keeps it breezy in bold colors and shades—proof that beach days are made for standout style.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/fashion-trends-of-the-season&quot;&gt;Read&lt;/a&gt;&lt;/p&gt;"></item_1>
