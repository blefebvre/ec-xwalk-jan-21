          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card News" model="card-news" modelFields="[image,text]" image="https://www.firstnet.com/content/dam/firstnet/images/offers/offer-card-firstnet-hospital-er-receiving-241217.jpg" text="&lt;p&gt;HEALTH AND WELLNESS&lt;/p&gt;&lt;p&gt;&lt;h3&gt;Stress relief for emergency physicians&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;This Mental Health Awareness Month, Ryan Fields-Spack shares strategies he learned in his 25+ years in emergency response.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;https://www.firstnet.com/community/news/stress-relief-techniques-for-emergency-physicians.html&quot;&gt;Read more&lt;/a&gt;&lt;/p&gt;"></item_1>
